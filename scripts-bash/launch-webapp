#!/usr/bin/env bash
# ---
# description: Launch a URL as a PWA in the default browser using --app= mode
# usage: launch-webapp <url>
# ---

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: launch-webapp <url>"
  exit 1
fi

URL="$1"

# Browsers that support --app= flag
APP_BROWSERS=("google-chrome-stable" "chromium" "chromium-browser" "brave" "vivaldi" "microsoft-edge")

# Detect default browser from .desktop file name
DEFAULT_DESKTOP=$(xdg-settings get default-web-browser 2>/dev/null || echo "")
DEFAULT_BROWSER=""

for browser in "${APP_BROWSERS[@]}"; do
  if [[ "$DEFAULT_DESKTOP" == *"$browser"* ]] || [[ "$DEFAULT_DESKTOP" == *"$(echo "$browser" | tr '-' '_')"* ]]; then
    DEFAULT_BROWSER="$browser"
    break
  fi
done

# Also check common desktop file patterns (e.g. google-chrome.desktop)
if [[ -z "$DEFAULT_BROWSER" ]]; then
  for browser in "${APP_BROWSERS[@]}"; do
    desktop_name="${browser}.desktop"
    if [[ "$DEFAULT_DESKTOP" == "$desktop_name" ]]; then
      DEFAULT_BROWSER="$browser"
      break
    fi
  done
fi

# Fallback to google-chrome-stable if default browser doesn't support --app=
if [[ -z "$DEFAULT_BROWSER" ]]; then
  for browser in "${APP_BROWSERS[@]}"; do
    if command -v "$browser" &>/dev/null; then
      DEFAULT_BROWSER="$browser"
      break
    fi
  done
fi

if [[ -z "$DEFAULT_BROWSER" ]]; then
  echo "Error: No supported browser found (need Chrome, Chromium, Brave, Vivaldi, or Edge)"
  exit 1
fi

setsid uwsm-app -- "$DEFAULT_BROWSER" --app="$URL" >/dev/null 2>&1 &
