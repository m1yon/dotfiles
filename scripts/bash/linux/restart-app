#!/usr/bin/env bash
# ---
# description: Kill and restart an application via uwsm-app
# ---

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: restart-app <app> [args...]"
  exit 1
fi

# T3 Code's bubblewrap sandbox sets no_new_privs and dies with the app, so a
# relaunch started inside it would die too. Run from the user manager instead;
# KillMode=process keeps the backgrounded app alive after this script exits.
if grep -q '^NoNewPrivs:[[:space:]]*1$' /proc/self/status; then
  exec systemd-run --user --wait --collect --quiet --property=KillMode=process \
    "$(readlink -f "$0")" "$@"
fi

app="$1"
shift || true
app_name="$(basename "$app")"

# Nix packages are often wrapped and run as .<name>-wrapped.
pkill -x -u "$USER" "$app_name" >/dev/null 2>&1 || true
pkill -x -u "$USER" ".${app_name}-wrapped" >/dev/null 2>&1 || true

# Give old processes a moment to exit before relaunch.
for _ in {1..20}; do
  if ! pgrep -x -u "$USER" "$app_name" >/dev/null 2>&1 && ! pgrep -x -u "$USER" ".${app_name}-wrapped" >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

setsid uwsm-app -- "$app" "$@" >/dev/null 2>&1 &
