#!/usr/bin/env bash
# ---
# description: Launch a TUI in a floating Ghostty window, or focus it if already open
# usage: launch-or-focus-tui <tui-command>
# ---

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: launch-or-focus-tui <tui-command>"
  exit 1
fi

TUI_CMD="$1"
TITLE="tui:${TUI_CMD}"

# Check if a window with this title already exists
ADDR=$(hyprctl clients -j | jq -r ".[] | select(.title == \"${TITLE}\") | .address" | head -n1)

if [[ -n "$ADDR" ]]; then
  hyprctl dispatch focuswindow "address:${ADDR}"
else
  ghostty +new-window --title="${TITLE}" -e "${TUI_CMD}"
fi
