{
    "layer": "top",
    "modules-left": ["clock"],
    "modules-center": ["hyprland/workspaces", "hyprland/submap"],
    "modules-right": ["battery", "wireplumber"],
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-full": "{capacity}% 󰁹",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo} — {capacity}%",
        "interval": 30
    },
    "clock": {
      "format": "{:%d %b  %I:%M %p}",
    },
    "wireplumber": {
      "format": "{icon}  {volume}%",
      "format-muted": " ",
      "format-icons": {
        "default": ["", " ", " "]
      },
      "max-volume": 100,
      "scroll-step": 0.2
    }
}
