{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "junior dev",
  "agent": {
    "build": {
      "disable": true
    },
    "junior dev": {
      "mode": "primary",
      "model": "opencode/kimi-k2.5"
    },
    "senior dev": {
      "mode": "primary",
      "model": "opencode/claude-opus-4.6"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/claude-opus-4.6"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/kimi-k2.5"
    }
  },
  "mcp": {
    "sentry": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    }
  }
}
