{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "websearch": "allow",
    "codesearch": "allow",
    "external_directory": {
      "/nix/store/*": "allow",
      "~/.local/share/opencode/repos/*": "allow",
      "~/My Vault/*": "allow"
    }
  },
  "lsp": true,
  "mcp": {
    "ynab": {
      "type": "local",
      "command": [
        "bunx",
        "github:calebl/ynab-mcp-server#36634cf98bdbea6c86dd237f1b048a51310559b4"
      ],
      "enabled": false,
      "environment": {
        "YNAB_API_TOKEN": "{env:YNAB_API_TOKEN}",
        "YNAB_BUDGET_ID": "{env:YNAB_BUDGET_ID}"
      }
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "references": {
    "effect": {
      "repository": "Effect-TS/effect-smol",
      "description": "Use this when there's a question about effect or you need to know how to do something in effect."
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "This folder contains your logs and your database. You can use it to introspect yourself and figure out any issues."
    },
    "obsidian": {
      "path": "~/My Vault"
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      }
    }
  }
}
